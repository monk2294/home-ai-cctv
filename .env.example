# Скопируйте в .env и при необходимости измените.
# Файл не должен содержать реальные секреты.

# Secure cookie для HTTPS (через OpenTunnel). Для plain HTTP LAN оставить false.
SESSION_COOKIE_SECURE=false

# Уровень логов сервера: debug | info | warn | error
LOG_LEVEL=info

# LAN-адрес хоста для WebRTC ICE-кандидата (порт 8555 tcp+udp опубликован).
# Пусто — остаётся значение из config/go2rtc.yaml (ручной шаг).
WEBRTC_LAN_CANDIDATE=
