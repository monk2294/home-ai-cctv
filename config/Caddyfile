{
	admin off
	auto_https off
}

:8080 {
	log {
		format json
		level INFO
	}

	# Readiness не публикуется наружу (спецификация 30, раздел 3).
	@ready path /api/v1/health/ready
	handle @ready {
		respond 404
	}

	@apiSession path /api/v1/auth/session*
	handle @apiSession {
		request_body {
			max_size 64KB
		}
		reverse_proxy server:8000
	}

	@apiLive path /api/v1/health/live*
	handle @apiLive {
		reverse_proxy server:8000
	}

	# Файловое воспроизведение: тело до 5 МиБ только на двух POST audio/play маршрутах (спецификация 50).
	@audioPlay {
		method POST
		path /api/v1/cameras/*/audio/play /api/v1/ai/cameras/*/audio/play
	}
	handle @audioPlay {
		request_body {
			max_size 5MiB
		}
		reverse_proxy server:8000
	}

	# MCP для ИИ-агентов: WAV base64 в JSON-RPC, лимит тела выше обычного API (спецификация 60).
	@mcp path /mcp*
	handle @mcp {
		request_body {
			max_size 8MiB
		}
		reverse_proxy mcp:3000 {
			flush_interval -1
		}
	}

	@api path /api/v1/*
	handle @api {
		# Тело JSON-запросов ограничено небольшим размером (спецификация 30, раздел 9).
		request_body {
			max_size 64KB
		}
		reverse_proxy server:8000 {
			# SSE и streaming без буферизации.
			flush_interval -1
		}
	}

	# Media endpoints: точечный allowlist, не весь /media/ (спецификация 30, раздел 3).
	@mediaAuth {
		path /media/api/ws*
		path /media/api/webrtc*
		path /media/api/stream.m3u8*
		path /media/api/hls/playlist.m3u8*
		path /media/api/hls/segment.ts*
		path /media/api/hls/init.mp4*
		path /media/api/hls/segment.m4s*
	}
	handle @mediaAuth {
		forward_auth server:8000 {
			uri /api/v1/auth/verify
		}
		reverse_proxy media:1984 {
			flush_interval -1
			# go2rtc ставит wildcard CORS на HLS; платформа работает same-origin.
			header_down -Access-Control-Allow-Origin
		}
	}

	# Остальные пути go2rtc (панель, /media/api/streams, config) не проксируются.
	@mediaOther path /media/*
	handle @mediaOther {
		respond 404
	}

	# Веб-клиент на context path /video (LAN-доступ без tunnel).
	# Ассеты и роутинг SPA идут под /video/*; API и media остаются в корне.
	# Корень отдаём на /video/: у SPA basename /video, без редиректа корень пустой.
	redir / /video/ permanent
	redir /video /video/ permanent

	handle /video/* {
		uri strip_prefix /video
		reverse_proxy web:80
	}

	# Всё остальное — статический SPA.
	handle {
		reverse_proxy web:80
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ws: wss:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
		-Server
	}
}

# Внутренний listener для автоматизаций: не публикуется через NodePort (спецификация 30, раздел 3).
# openHAB берёт снимок без собственных учётных данных, AI-токен подставляет прокси из окружения.
:8081 {
	log {
		format json
		level INFO
	}

	@aiSnapshot {
		method GET
		path /api/v1/ai/cameras/*/snapshot.jpg
	}
	handle @aiSnapshot {
		reverse_proxy server:8000 {
			header_up Authorization "Bearer {$CCTV_AI_TOKEN}"
		}
	}

	handle {
		respond 404
	}
}
